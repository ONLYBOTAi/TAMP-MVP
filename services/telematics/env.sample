# Database settings
DATABASE_URL=sqlite:///./db/tamp_telematics.db

# JWT settings
SECRET_KEY=your_jwt_secret_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Service settings
SERVICE_PORT=8003
SERVICE_HOST=0.0.0.0

# Authentication service
AUTH_SERVICE_URL=http://auth-service:8000

# Telematics settings
MAX_TELEMETRY_BATCH_SIZE=100
TELEMETRY_PROCESSING_INTERVAL=60

# Alert thresholds
SPEED_LIMIT=120.0
ENGINE_TEMP_WARNING=90.0
ENGINE_TEMP_CRITICAL=100.0
BATTERY_VOLTAGE_LOW=11.5
FUEL_LEVEL_WARNING=15.0 