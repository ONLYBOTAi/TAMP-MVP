[run]
source = .
omit =
    */tests/*
    */migrations/*
    */alembic/*
    */venv/*
    */__init__.py
    */config.py
    */settings.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    pass
    raise ImportError
    except ImportError:
    def main\(\):

[html]
directory = coverage_html_report 